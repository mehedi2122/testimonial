includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # DataAwareRule interface requires a $data property even when the
        # concrete rule does not need it. Laravel uses this pattern widely.
        -
            identifier: property.onlyWritten
            paths:
                - app/Rules/SubmissionValuesForSpace.php
